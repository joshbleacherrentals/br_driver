{
  "expo": {
    "name": "Bleacher Rentals Driver",
    "owner": "bleacher-rentals",
    "slug": "br_driver",
    "orientation": "portrait",
    "scheme": "brdriver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bleacherrentals.driver.dev",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["waze", "comgooglemaps", "maps"]
      },
      "icon": {
        "dark": "./assets/icons/ios-dark.png",
        "light": "./assets/icons/ios-light.png",
        "tinted": "./assets/icons/ios-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "monochromeImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.bleacherrentals.driver.dev",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "geo" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/icons/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-notifications",
      "expo-apple-authentication",
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Bleacher Rentals Driver saves the photos you capture to your device's photo library so an original copy is kept safe until it finishes uploading.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      "./plugins/withMediaPermissionScrub",
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "eb97b59b-bd6b-4c6b-9f5e-3648b258f93e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eb97b59b-bd6b-4c6b-9f5e-3648b258f93e"
    }
  }
}
